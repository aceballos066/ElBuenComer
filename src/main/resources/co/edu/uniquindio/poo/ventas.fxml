<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.viewController.VentasViewController"
            prefWidth="850.0" prefHeight="620.0">
    <children>
        <VBox spacing="12.0" AnchorPane.topAnchor="15.0" AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="15.0">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>
            <children>
                <Label text="Ventas del restaurante" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                <TextArea fx:id="txtResultados" editable="false" wrapText="false" VBox.vgrow="ALWAYS"/>
                <HBox spacing="10.0">
                    <children>
                        <Button text="Actualizar" onAction="#onActualizar"/>
                        <Button text="Volver" onAction="#onVolver"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>